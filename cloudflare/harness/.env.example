# Copy to .env (same folder) and fill in. .env is never committed.
#
# Account ID: Cloudflare dashboard > Workers & Pages > right-hand column, or
# the long hex string in the dashboard address after dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=PASTE_ACCOUNT_ID
#
# API token: Cloudflare dashboard > My Profile > API Tokens > Create Token
# (see README.md for the permissions to tick)
CLOUDFLARE_API_TOKEN=PASTE_API_TOKEN
